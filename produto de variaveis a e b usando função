print("Calculo de produto de duas variaveis")
a = float(input("Digite valor de a:\n"))
b = float(input("Digite valor de b:\n"))

def produto(a,b):
    return a * b

resultado = produto(a,b)

print(f"O valor do produto é:\n {resultado}")
