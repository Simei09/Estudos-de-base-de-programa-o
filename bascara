print("############   FORMULA DE BASCARA ############\n##########  ENCONTRA AS RAIZES X1 E X2  ######")

a = float(input("Inserir valor de a:\n"))
b = float(input("Inserir valor de b:\n"))
c = float(input("Inserir valor de c:\n"))

def delta_calcular(a, b, c):
    return (b)**2 - 4 * a * c

delta = delta_calcular(a, b, c)

if delta < 0:
    print("Não possui raizes reais!")
else:

    x1 = (-b + (delta)**(1/2))/(2 * a)
    x2 = (-b - (delta)**(1/2))/(2 * a)

    print(f"AS raizes são: x1 = {x1} e x2 = {x2}")
